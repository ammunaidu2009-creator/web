/* Base Reset & Variables */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Outfit', sans-serif;
}

body {
    background-color: #0b0f19;
    color: #f3f4f6;
    line-height: 1.6;
}

/* Navbar */
.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(15, 23, 42, 0.9);
    backdrop-filter: blur(10px);
    padding: 1rem 5%;
    position: sticky;
    top: 0;
    z-index: 1000;
    border-bottom: 1px solid #1e293b;
}

.logo {
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
}

.logo i {
    color: #e50914;
    margin-right: 8px;
}

.logo span {
    color: #e50914;
}

.nav-links {
    display: flex;
    gap: 2rem;
}

.nav-links a {
    text-decoration: none;
    color: #94a3b8;
    font-weight: 500;
    transition: color 0.2s;
}

.nav-links a.active, .nav-links a:hover {
    color: #ffffff;
}

.search-bar {
    display: flex;
    align-items: center;
    background: #1e293b;
    padding: 0.5rem 1rem;
    border-radius: 50px;
    border: 1px solid #334155;
}

.search-bar i {
    color: #94a3b8;
    margin-right: 8px;
}

.search-bar input {
    background: transparent;
    border: none;
    outline: none;
    color: #fff;
    font-size: 0.9rem;
}

.search-bar input::placeholder {
    color: #64748b;
}

/* Container */
.container {
    max-width: 1200px;
    margin: 2rem auto;
    padding: 0 1.5rem;
}

/* Hero Section */
.hero-section {
    background: linear-gradient(rgba(11, 15, 25, 0.3), rgba(11, 15, 25, 0.9)), 
                url('https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&q=80&w=1200') center/cover no-repeat;
    border-radius: 16px;
    padding: 4rem 2rem;
    margin-bottom: 3rem;
    border: 1px solid #1e293b;
    display: flex;
    align-items: flex-end;
    min-height: 400px;
}

.hero-content {
    max-width: 600px;
}

.badge {
    background: #e50914;
    color: white;
    padding: 0.25rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 4px;
    text-transform: uppercase;
}

.hero-content h1 {
    font-size: 3rem;
    font-weight: 700;
    margin: 0.5rem 0;
    color: #fff;
}

.hero-synopsis {
    color: #cbd5e1;
    font-size: 1rem;
    margin-bottom: 1rem;
}

.hero-meta {
    display: flex;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
}

.hero-meta i {
    color: #e50914;
    margin-right: 4px;
}

.rating-badge {
    color: #f59e0b !important;
    font-weight: 600;
}

.primary-btn {
    background: #e50914;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
}

.primary-btn:hover {
    background: #b80710;
    transform: translateY(-2px);
}

/* Movies Grid Section */
.movies-section h2 {
    font-size: 1.5rem;
    margin-bottom: 1.5rem;
    color: #fff;
    border-left: 4px solid #e50914;
    padding-left: 10px;
}

.movie-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 2rem;
}

/* Movie Card */
.movie-card {
    background: #111827;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #1f2937;
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
}

.movie-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.4);
    border-color: #374151;
}

.poster-container {
    position: relative;
    height: 350px;
    width: 100%;
}

.poster-container img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.card-rating {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(4px);
    color: #f59e0b;
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 4px;
}

.card-content {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.genres {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
}

.genre {
    background: #1f2937;
    color: #94a3b8;
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 500;
}

.movie-card h3 {
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.2rem;
}

.release-date {
    font-size: 0.75rem;
    color: #64748b;
    margin-bottom: 0.75rem;
}

.synopsis-snippet {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.25rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #1f2937;
    padding-top: 0.75rem;
    margin-top: auto;
}

.critic-score {
    font-size: 0.8rem;
    color: #10b981;
    font-weight: 600;
}

.details-btn {
    background: transparent;
    border: 1px solid #374151;
    color: #fff;
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
}

.details-btn:hover {
    background: #1f2937;
    border-color: #64748b;
}

/* Responsive adjustments */
@media (max-width: 768px) {
    .navbar {
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
    }
    
    .hero-content h1 {
        font-size: 2rem;
    }
}